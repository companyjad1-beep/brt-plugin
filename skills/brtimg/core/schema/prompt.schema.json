{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brtimg.local/schema/prompt.schema.json",
  "title": "프롬프트 산출물",
  "description": "이미지 생성용 최종 프롬프트, 설계 메모, 변형안, 참조 정보를 함께 저장하는 스키마입니다.",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "title",
    "targetGenerator",
    "modes",
    "finalText",
    "designMemo",
    "variants",
    "createdAt"
  ],
  "properties": {
    "schemaKind": {
      "description": "검증 도구가 스키마를 자동 추론할 때 사용할 수 있는 선택 식별자입니다.",
      "type": "string",
      "enum": ["prompt"]
    },
    "schemaVersion": {
      "description": "스키마 버전입니다. 현재 버전은 1입니다.",
      "type": "integer",
      "const": 1
    },
    "id": {
      "description": "프롬프트 산출물의 안정적인 식별자입니다.",
      "type": "string",
      "minLength": 1
    },
    "title": {
      "description": "사람이 읽을 수 있는 프롬프트 제목입니다.",
      "type": "string",
      "minLength": 1
    },
    "targetGenerator": {
      "description": "이 프롬프트가 목표로 하는 이미지 생성기입니다.",
      "type": "string",
      "enum": ["gpt-image-2", "nano-banana-pro", "seedance-2"]
    },
    "modes": {
      "description": "프롬프트가 지원하는 실행 모드 목록입니다.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": ["oneshot", "multi3", "conversational", "multimodal"]
      }
    },
    "finalText": {
      "description": "생성기에 전달할 최종 프롬프트 본문입니다.",
      "type": "string",
      "minLength": 1
    },
    "designMemo": {
      "description": "요청 해석, 핵심 선택, 가정, 변경점, 루프 추적을 기록하는 설계 메모입니다.",
      "type": "object",
      "required": ["interpretation", "keyChoices", "assumptions", "changePoints", "loopTrace"],
      "properties": {
        "interpretation": {
          "description": "사용자 요청을 어떻게 해석했는지에 대한 설명입니다.",
          "type": "string",
          "minLength": 1
        },
        "keyChoices": {
          "description": "생성 품질을 위해 의도적으로 선택한 핵심 방향입니다.",
          "type": "string",
          "minLength": 1
        },
        "assumptions": {
          "description": "명시되지 않은 요구에 대해 둔 작업 가정 목록입니다.",
          "type": "array",
          "items": { "type": "string" }
        },
        "changePoints": {
          "description": "반복 과정에서 조정한 주요 변경점 목록입니다.",
          "type": "array",
          "items": { "type": "string" }
        },
        "loopTrace": {
          "description": "코어 엔진 루프의 판단 흐름을 요약한 패스별 기록입니다.",
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "required": ["pass", "type", "summary", "weaknesses", "changesApplied"],
            "properties": {
              "pass": {
                "description": "루프 패스 번호입니다.",
                "type": "number"
              },
              "type": {
                "description": "해당 패스의 루프 단계입니다.",
                "type": "string",
                "enum": ["draft", "critique", "improve"]
              },
              "summary": {
                "description": "해당 패스의 핵심 판단 요약입니다.",
                "type": "string",
                "minLength": 1
              },
              "weaknesses": {
                "description": "해당 패스에서 발견한 약점 목록입니다.",
                "type": "array",
                "items": { "type": "string" }
              },
              "changesApplied": {
                "description": "해당 패스 이후 적용한 변경 목록입니다.",
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "variants": {
      "description": "동일 목표를 위한 대체 프롬프트 변형 목록입니다.",
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["label", "text"],
        "properties": {
          "label": {
            "description": "변형을 구분하는 짧은 이름입니다.",
            "type": "string",
            "minLength": 1
          },
          "text": {
            "description": "변형 프롬프트 본문입니다.",
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "characterSheetRef": {
      "description": "재사용할 캐릭터 시트 파일 또는 식별자 참조입니다.",
      "type": "string",
      "minLength": 1
    },
    "referenceImagePaths": {
      "description": "참조 이미지 경로 목록입니다.",
      "type": "array",
      "items": { "type": "string" }
    },
    "checklistResults": {
      "description": "체크리스트 항목별 판정과 근거 목록입니다.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["item", "verdict", "evidence"],
        "properties": {
          "item": {
            "description": "체크리스트 항목 이름입니다.",
            "type": "string",
            "minLength": 1
          },
          "verdict": {
            "description": "체크리스트 판정입니다.",
            "type": "string",
            "enum": ["충족", "부분 충족", "미달", "판정 불가"]
          },
          "evidence": {
            "description": "판정 근거입니다.",
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "createdAt": {
      "description": "파일을 생성한 시각의 ISO 8601 문자열입니다.",
      "type": "string",
      "minLength": 1
    }
  }
}
