{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brtimg.local/schema/eval-report.schema.json",
  "title": "평가 리포트",
  "description": "체크리스트, 골든 블라인드, 실제 생성 평가 결과를 기록하는 스키마입니다.",
  "type": "object",
  "required": ["schemaVersion", "id", "promptRef", "layer", "verdict", "createdAt"],
  "properties": {
    "schemaKind": {
      "description": "검증 도구가 스키마를 자동 추론할 때 사용할 수 있는 선택 식별자입니다.",
      "type": "string",
      "enum": ["eval-report"]
    },
    "schemaVersion": {
      "description": "스키마 버전입니다. 현재 버전은 1입니다.",
      "type": "integer",
      "const": 1
    },
    "id": {
      "description": "평가 리포트의 안정적인 식별자입니다.",
      "type": "string",
      "minLength": 1
    },
    "promptRef": {
      "description": "평가 대상 프롬프트 파일 또는 식별자 참조입니다.",
      "type": "string",
      "minLength": 1
    },
    "layer": {
      "description": "평가가 수행된 계층입니다.",
      "type": "string",
      "enum": ["checklist", "golden-blind", "realgen"]
    },
    "verdict": {
      "description": "평가 리포트의 전체 판정입니다.",
      "type": "string",
      "enum": ["passed", "failed", "provisional"]
    },
    "items": {
      "description": "체크리스트 계층의 항목별 판정 목록입니다.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["item", "verdict", "evidence"],
        "properties": {
          "item": {
            "description": "체크리스트 항목 이름입니다.",
            "type": "string",
            "minLength": 1
          },
          "verdict": {
            "description": "체크리스트 판정입니다.",
            "type": "string",
            "enum": ["충족", "부분 충족", "미달", "판정 불가"]
          },
          "evidence": {
            "description": "판정 근거입니다.",
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "blind": {
      "description": "골든 블라인드 계층의 집계와 사용자 확인 정보입니다.",
      "type": "object",
      "required": ["N", "M", "accuracy", "band", "user_confirmation"],
      "properties": {
        "N": {
          "description": "블라인드 번들의 하네스 산출 수입니다.",
          "type": "integer"
        },
        "M": {
          "description": "holdout 골든셋 수입니다.",
          "type": "integer"
        },
        "accuracy": {
          "description": "심판이 올바르게 분류한 수 / (N+M)이며, 소수 4자리로 반올림한 값입니다.",
          "type": "number"
        },
        "band": {
          "description": "반올림된 accuracy 기준으로 0.40≤accuracy≤0.60 포함 비교해 해석한 등급 또는 구간입니다.",
          "type": "string",
          "minLength": 1
        },
        "user_confirmation": {
          "description": "블라인드 평가 결과에 대한 사용자 확인 기록입니다.",
          "type": "object",
          "required": ["verdict", "note", "timestamp"],
          "properties": {
            "verdict": {
              "description": "사용자 확인 판정입니다.",
              "type": "string",
              "minLength": 1
            },
            "note": {
              "description": "사용자 확인 메모입니다.",
              "type": "string"
            },
            "timestamp": {
              "description": "사용자 확인 시각의 ISO 8601 문자열입니다.",
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "realgen": {
      "description": "실제 생성 계층의 실행 경로와 반복 기록입니다.",
      "type": "object",
      "required": ["path", "iterations", "maxIterations"],
      "properties": {
        "path": {
          "description": "실제 생성 수행 경로입니다.",
          "type": "string",
          "enum": ["A-mcp", "B-manual"]
        },
        "iterations": {
          "description": "실제 생성 반복별 변경과 체크리스트 변화 목록입니다.",
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "object",
            "required": ["n", "changes", "checklistDelta"],
            "properties": {
              "n": {
                "description": "반복 번호입니다.",
                "type": "integer"
              },
              "changes": {
                "description": "해당 반복에서 적용한 변경 목록입니다.",
                "type": "array",
                "items": { "type": "string" }
              },
              "checklistDelta": {
                "description": "체크리스트 결과의 변화 요약입니다.",
                "type": "string"
              }
            }
          }
        },
        "maxIterations": {
          "description": "허용되는 최대 실제 생성 반복 수입니다.",
          "type": "integer",
          "const": 3
        }
      }
    },
    "createdAt": {
      "description": "파일을 생성한 시각의 ISO 8601 문자열입니다.",
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["layer"],
        "properties": { "layer": { "const": "checklist" } }
      },
      "then": {
        "required": ["items"]
      }
    },
    {
      "if": {
        "required": ["layer"],
        "properties": { "layer": { "const": "golden-blind" } }
      },
      "then": {
        "required": ["blind"]
      }
    },
    {
      "if": {
        "required": ["layer"],
        "properties": { "layer": { "const": "realgen" } }
      },
      "then": {
        "required": ["realgen"]
      }
    }
  ]
}
